{
    "name": "wallet-api-test-suite",
    "version": "1.0.0",
    "description": "Test suite for the Wallet API",
    "main": "index.js",
    "scripts": {
        "pretest": "node utils/setupReports.js",
        "test": "jest",
        "test:wallet": "jest tests/wallet",
        "test:transaction": "jest tests/wallet/transaction.test.js",
        "report": "allure generate --clean allure-results -o allure-report && allure open allure-report",
        "setup": "node utils/setupTestData.js",
        "check:allure": "node utils/checkAllure.js",
        "postinstall": "npm run setup"
    },
    "keywords": [
        "api",
        "testing",
        "wallet"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "axios": "^1.8.4",
        "dotenv": "^16.4.7",
        "jasmine": "^5.6.0",
        "uuid": "^11.1.0",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "allure-commandline": "^2.33.0",
        "allure-jest": "^3.2.1",
        "jest": "^29.7.0",
        "jest-allure": "^0.1.3",
        "jest-jasmine2": "^29.7.0"
    }
}
